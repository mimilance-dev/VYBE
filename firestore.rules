rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validProfile(data, userId) {
      return data.keys().hasOnly([
          'id', 'displayName', 'email', 'photoUrl', 'createdAt', 'lastSeenAt'
        ])
        && data.keys().hasAll(['id', 'createdAt', 'lastSeenAt'])
        && data.id == userId
        && data.createdAt is timestamp
        && data.lastSeenAt is timestamp
        && (!('displayName' in data) || data.displayName == null
          || (data.displayName is string && data.displayName.size() <= 100))
        && (!('email' in data) || data.email == null
          || (data.email is string && data.email.size() <= 320))
        && (!('photoUrl' in data) || data.photoUrl == null
          || (data.photoUrl is string && data.photoUrl.size() <= 2048));
    }

    match /users/{userId} {
      allow read: if ownsUser(userId);
      allow create: if ownsUser(userId)
        && validProfile(request.resource.data, userId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSeenAt == request.time;
      allow update: if ownsUser(userId)
        && validProfile(request.resource.data, userId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastSeenAt == request.time;
      allow delete: if ownsUser(userId);
    }

    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 1
        && request.resource.data.participants[0] == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.participants is list
        && request.resource.data.participants.size() <= 2
        && (request.auth.uid in resource.data.participants
          || request.auth.uid in request.resource.data.participants);
      allow delete: if false;

      match /playbackCommands/{commandId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.commandId == commandId
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.participants;
        allow update, delete: if false;
      }

      match /participants/{participantId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.auth.uid == participantId
          && request.resource.data.userId == participantId;
        allow delete: if request.auth != null && request.auth.uid == participantId;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}