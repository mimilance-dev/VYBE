rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() { return request.auth != null; }

    function isParticipant(roomId) {
      return authenticated()
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.participants;
    }

    match /users/{userId} {
      allow read: if authenticated() && request.auth.uid == userId;
      allow create: if authenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["id", "displayName", "email", "photoUrl", "createdAt", "lastSeenAt", "preferences"])
        && request.resource.data.id == userId
        && (!("displayName" in request.resource.data) || request.resource.data.displayName == null || request.resource.data.displayName is string)
        && (!("email" in request.resource.data) || request.resource.data.email == null || request.resource.data.email is string)
        && (!("photoUrl" in request.resource.data) || request.resource.data.photoUrl == null || request.resource.data.photoUrl is string)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.lastSeenAt is timestamp
        && request.resource.data.preferences is map
        && request.resource.data.preferences.keys().hasOnly(["notificationsEnabled", "reducedMotion"])
        && request.resource.data.preferences.notificationsEnabled is bool
        && request.resource.data.preferences.reducedMotion is bool;
      allow update: if authenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["id", "displayName", "email", "photoUrl", "createdAt", "lastSeenAt", "preferences"])
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && (!("displayName" in request.resource.data) || request.resource.data.displayName == null || request.resource.data.displayName is string)
        && (!("email" in request.resource.data) || request.resource.data.email == null || request.resource.data.email is string)
        && (!("photoUrl" in request.resource.data) || request.resource.data.photoUrl == null || request.resource.data.photoUrl is string)
        && request.resource.data.lastSeenAt is timestamp
        && request.resource.data.preferences is map
        && request.resource.data.preferences.keys().hasOnly(["notificationsEnabled", "reducedMotion"])
        && request.resource.data.preferences.notificationsEnabled is bool
        && request.resource.data.preferences.reducedMotion is bool;
      allow delete: if authenticated() && request.auth.uid == userId;
    }

    match /rooms/{roomId} {
      // Room documents are read only after membership. Room writes and all
      // presence/roster transitions are performed by trusted server functions.
      allow get: if isParticipant(roomId);
      allow list: if false;
      allow create, update, delete: if false;

      match /participants/{participantId} {
        allow read: if isParticipant(roomId);
        allow create, update, delete: if false;
      }

      match /playbackCommands/{commandId} {
        allow read: if isParticipant(roomId);
        allow create, update, delete: if false;
      }
    }

    // Invite codes are intentionally not queryable from clients. The
    // resolveRoomInvite callable performs the authenticated lookup.
    match /roomInvites/{code} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
